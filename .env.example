# ClearVoice backend configuration.
# Copy to backend/.env (or export as environment variables). All values optional.

# --- storage ---
DATA_DIR=./data

# --- limits / guardrails ---
MAX_UPLOAD_MB=300
MAX_DURATION_SEC=1200
QUOTA_PER_IP_PER_DAY=20

# --- separation model ---
DEMUCS_MODEL=htdemucs_ft
# DEMUCS_SEGMENT=8        # lower (e.g. 8) if the GPU runs out of memory
DEMUCS_OVERLAP=0.25
DEVICE=auto               # auto | cuda | cpu

# --- queue ---
# REDIS_URL=redis://localhost:6379/0    # unset = in-process thread queue (no worker process needed)
MAX_CONCURRENT_JOBS=1

# --- retention ---
FILE_TTL_HOURS=24
CLEANUP_INTERVAL_MIN=30

# --- dev ---
DEV_FAKE_SEPARATION=0     # 1 = skip Demucs, copy input to both stems (pipeline/UI testing only)

# --- CORS ---
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4173,http://localhost:8080
