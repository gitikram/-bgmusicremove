# GPU (CUDA 12.1) build of the ClearVoice backend.
# Requires NVIDIA drivers + nvidia-container-toolkit on the host.
# Use with: docker compose -f docker-compose.yml -f docker-compose.gpu.yml up --build
FROM python:3.11-slim

RUN apt-get update \
    && apt-get install -y --no-install-recommends ffmpeg \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /srv

COPY requirements.txt .
# CUDA-enabled torch wheels first; the remaining requirements resolve against them.
RUN pip install --no-cache-dir torch torchaudio --index-url https://download.pytorch.org/whl/cu121 \
    && pip install --no-cache-dir -r requirements.txt

COPY app ./app

ENV DATA_DIR=/data \
    PYTHONUNBUFFERED=1
VOLUME /data
EXPOSE 8000

CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]
